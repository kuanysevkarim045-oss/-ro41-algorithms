using System;

namespace TextToolsApp
{
    class Program
    {
        static void Main(string[] args)
        {
            Console.WriteLine("=== ТЕСТИРОВАНИЕ КЛАССА TextTools ===\n");

            // Тесты для CountWords
            Console.WriteLine("--- 1. Тесты метода CountWords ---");
            RunWordCountTest("", 0);
            RunWordCountTest("    ", 0);
            RunWordCountTest(" a  b ", 2);
            RunWordCountTest("Ахметов Ерлан", 2);
            Console.WriteLine();

            // Тесты для IsPalindrome
            Console.WriteLine("--- 2. Тесты метода IsPalindrome ---");
            RunPalindromeTest("", true);
            RunPalindromeTest("    ", true);
            RunPalindromeTest("А роза упала на лапу Азора", true);
            RunPalindromeTest("Ахметов Ерлан", false);
            Console.WriteLine();

            // Тесты для Initials
            Console.WriteLine("--- 3. Тесты метода Initials ---");
            RunInitialsTest("", "");
            RunInitialsTest("   ", "");
            RunInitialsTest("Ахметов Ерлан", "А. Е.");
            RunInitialsTest("Ахметов Ерлан Серикұлы", "А. Е. С.");
            Console.WriteLine();

            // Тесты для Repeat
            Console.WriteLine("--- 4. Тесты метода Repeat ---");
            RunRepeatTest("abc", 3, "abcabcabc");
            RunRepeatTest("", 5, "");
            RunRepeatTest("Test", 0, "");
            Console.WriteLine();
        }

        static void RunWordCountTest(string input, int expected)
        {
            int actual = TextTools.CountWords(input);
            PrintResult(input, expected, actual);
        }

        static void RunPalindromeTest(string input, bool expected)
        {
            bool actual = TextTools.IsPalindrome(input);
            PrintResult(input, expected, actual);
        }

        static void RunInitialsTest(string input, string expected)
        {
            string actual = TextTools.Initials(input);
            PrintResult(input, expected, actual);
        }

        static void RunRepeatTest(string input, int n, string expected)
        {
            string actual = TextTools.Repeat(input, n);
            PrintResult($"\"{input}\", n={n}", expected, actual);
        }

        static void PrintResult<T>(string input, T expected, T actual)
        {
            string status = expected.Equals(actual) ? "OK" : "FAIL";
            Console.WriteLine($"Вход: [{input}] | Ожидание: [{expected}] | Факт: [{actual}] | Статус: {status}");
        }
    }
}
