using System;
using System.Text;

namespace TextToolsApp
{
    public static class TextTools
    {
        /// <summary>
        /// 1. Подсчет количества слов (лишние пробелы не учитываются).
        /// </summary>
        public static int CountWords(string s)
        {
            if (string.IsNullOrWhiteSpace(s))
            {
                return 0;
            }

            int count = 0;
            bool inWord = false;

            for (int i = 0; i < s.Length; i++)
            {
                if (!char.IsWhiteSpace(s[i]))
                {
                    if (!inWord)
                    {
                        inWord = true;
                        count++;
                    }
                }
                else
                {
                    inWord = false;
                }
            }

            return count;
        }

        /// <summary>
        /// 2. Проверка, является ли строка палиндромом (без учета регистра и пробелов).
        /// </summary>
        public static bool IsPalindrome(string s)
        {
            if (string.IsNullOrEmpty(s))
            {
                return true; // Пустую строку условно считаем палиндромом
            }

            int left = 0;
            int right = s.Length - 1;

            while (left < right)
            {
                // Пропускаем пробелы слева
                while (left < right && char.IsWhiteSpace(s[left]))
                {
                    left++;
                }

                // Пропускаем пробелы справа
                while (left < right && char.IsWhiteSpace(s[right]))
                {
                    right--;
                }

                // Сравниваем символы без учета регистра
                if (char.ToLower(s[left]) != char.ToLower(s[right]))
                {
                    return false;
                }

                left++;
                right--;
            }

            return true;
        }

        /// <summary>
        /// 3. Получение инициалов из полного имени ("Ахметов Ерлан Серикұлы" -> "А. Е. С.").
        /// </summary>
        public static string Initials(string fullName)
        {
            if (string.IsNullOrWhiteSpace(fullName))
            {
                return string.Empty;
            }

            // Разобьем строку на слова вручную без использования LINQ и Split с массивами
            StringBuilder result = new StringBuilder();
            bool newWord = true;

            for (int i = 0; i < fullName.Length; i++)
            {
                char c = fullName[i];

                if (char.IsWhiteSpace(c))
                {
                    newWord = true;
                }
                else if (newWord)
                {
                    if (result.Length > 0)
                    {
                        result.Append(' ');
                    }
                    result.Append(char.ToUpper(c)).Append('.');
                    newWord = false;
                }
            }

            return result.ToString();
        }

        /// <summary>
        /// 4. Повторение строки n раз с использованием StringBuilder.
        /// </summary>
        public static string Repeat(string s, int n)
        {
            if (string.IsNullOrEmpty(s) || n <= 0)
            {
                return string.Empty;
            }

            StringBuilder sb = new StringBuilder(s.Length * n);
            for (int i = 0; i < n; i++)
            {
                sb.Append(s);
            }

            return sb.ToString();
        }
    }
}
